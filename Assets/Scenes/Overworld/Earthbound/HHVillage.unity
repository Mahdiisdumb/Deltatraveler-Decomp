  m_Script: {fileID: 11500000, guid: a64bf11828c8300989d11bfab7257978, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* Though you may not believe it,^05\n  I am a healer.'
  - '* If you have a condition that\n  cannot be treated at the\n  hospital...'
  - '* It''s my job to cure you.'
  - '* It appears that you are not\n  suffering of anything\n  strange...'
  - '* Nor are you suffering a\n  concussion.'
  - '* Come back when necessary.'
  sounds:
  - snd_text
  - snd_text
  - snd_text
  - snd_text
  - snd_text
  - snd_text
  speed: 000000000000000000000000000000000000000000000000
  portraits:
  - 
  - 
  - 
  - 
  - 
  - 
  remarks: []
  secondaryLines: 0
  lines2:
