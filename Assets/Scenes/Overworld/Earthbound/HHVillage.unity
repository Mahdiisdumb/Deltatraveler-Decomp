--- !u!114 &608
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 126}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 12cf6c0ad7b3d747a5e7d5a82df8ac50, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* Hello there,^05 young travellers!'
  - '* I am not your enemy,^05 but an\n  average mole.'
  - '* I would like to add a bit\n  of flavor to your experience.'
  - '* Or would a bit of advice be\n  more useful to you...?'
  - '* I''m willing to help either way!'
  sounds:
  - snd_text
  speed: 00000000
  portraits: []
  remarks: []
  left: Yes
  leftOffset: {x: 0, y: 0}
  right: No
  rightOffset: {x: 20, y: 0}
  up: Advice
  upOffset: {x: 0, y: 0}
  down:
  downOffset: {x: 0, y: 0}
  centerOffset: {x: 0, y: 0}
  talkSprites:
  - {fileID: 21300000, guid: ef181195befff8540ae3b7578858b35d, type: 2}
  - {fileID: 21300000, guid: 01e97ce607c01a1409840e69493af4a7, type: 2}
  talkFramerate: 6
  adviceLines:
  - '* Did you notice the blue\n  bullets in the last fight?'
  - '* Those weren''t just for show.^05\n* You can actually do something\n  special to avoid them!'
  - '* If your SOUL isn''t moving,^05 then\n  they''ll phase through you!'
  - '* Though I hear if they hit you\n  on a moving platform,^05 it''ll\n  hurt even if you stand still.'
  - '* So be careful to not be\n  moving AT ALL.'
  adviceSounds:
  - snd_text
  adviceSpeed: 00000000
  advicePortraits: []
