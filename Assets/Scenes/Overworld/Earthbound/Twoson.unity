  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* I''m from the bicycle shop\n  "Punk-Sure"!'
  - '* Bicycles are so much fun\n  and are so convenient...'
  - '* Unfortunately for you three,\n  I don''t have a three-seating\n  bike.'
  - '* Now you''ll never know the\n  fast speed of bike riding!'
  sounds:
  - snd_text
  - snd_text
  - snd_text
  - snd_text
  speed: 00000000000000000000000000000000
  portraits: []
  remarks: []
  secondaryLines: 1
  lines2:
  - '* We don''t even need a\n  bike.\n* We can run.'
  - '* W-what???^10\n* But I thought my gimmick was\n  unique!!!'
  sounds2:
  - snd_txtsus
  - snd_text
