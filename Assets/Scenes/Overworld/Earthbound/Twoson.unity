  - snd_text
  - snd_text
  - snd_text
  - snd_text
  speed: 00000000000000000000000000000000
  portraits: []
  remarks: []
  secondaryLines: 1
  lines2:
  - '* We don''t even need a\n  bike.\n* We can run.'
  - '* W-what???^10\n* But I thought my gimmick was\n  unique!!!'
  sounds2:
  - snd_txtsus
  - snd_text
