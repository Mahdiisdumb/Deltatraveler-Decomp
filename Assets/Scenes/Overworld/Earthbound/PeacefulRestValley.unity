  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  itemID: 18
  price: 15
  buyText: Yes
  rejectText: No
  lines:
  - '* Humm dee dum dum dum...'
  - '* I''m hunting for mushrooms,\n^10  but I bought too many from\n  a kid with a red hat.'
  - '* Would you be willing to\n  buy one of them for 15G?'
  sounds:
  - snd_text
  - snd_text
  - snd_text
  speed: 000000000000000000000000
  portraits: []
  remarks: []
  purchaseLines:
  - '* Thank you.\n  It''s a weight lifted off\n  my basket.'
  - '* (You got the Quiet Shroom.)\n* (It was added to your ITEMs.)'
  purchaseSounds:
  - snd_text
  - snd_text
  purchaseSpeed: 0000000000000000
  purchasePortraits: []
  purchaseRemarks: []
  rejectLines:
  - '* If I don''t get anyone to\n  buy these,^10 they''ll turn\n  evil again!'
  rejectSounds:
  - snd_text
  rejectSpeed: 00000000
  rejectPortraits:
  - 
  rejectRemarks: []
  noSpaceLines:
  - '* You don''t have enough space\n  to carry it.'
  - '* That''ll surely make the shroom\n  angry.^05\n* You can keep your money.'
  - '* (Wait,^05 angry?)'
  noSpaceSounds:
  - snd_text
  - snd_text
  - snd_txtnoe
  noSpaceSpeed: 000000000000000000000000
  noSpacePortraits:
  - 
  - 
  - no_playful
  noSpaceRemarks: []
  noMoneyLines:
  - '* Oh... ^10you don''t have enough\n  money.'
  - '* If I don''t get anyone to\n  buy these,^10 they''ll turn\n  evil again!'
  - '* (You could give it to\n  us for free...)'
  noMoneySounds:
  - snd_text
