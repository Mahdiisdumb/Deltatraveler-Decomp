--- !u!114 &1101
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 239}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 12cf6c0ad7b3d747a5e7d5a82df8ac50, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* Hello there,^05 young travellers!'
  - '* I am not your enemy,^05 but an\n  average mole.'
  - '* I would like to add a bit\n  of flavor to your experience.'
  - '* Or would a bit of advice be\n  more useful to you...?'
  - '* I''m willing to help either way!'
  sounds:
  - snd_text
  speed: 00000000
  portraits: []
  remarks: []
  left: Yes
  leftOffset: {x: 0, y: 0}
  right: No
  rightOffset: {x: 20, y: 0}
  up: Advice
  upOffset: {x: 0, y: 0}
  down:
  downOffset: {x: 0, y: 0}
  centerOffset: {x: 0, y: 0}
  talkSprites:
  - {fileID: 21300000, guid: 298e82843dac4594384c5d66e39674b5, type: 2}
  - {fileID: 21300000, guid: eb2e90bacd58e3b458c265459ae81fa6, type: 2}
  talkFramerate: 6
  adviceLines:
  - '* A few of the enemies here will\n  want you to do something\n  to become friends with them.'
  - '* For example, the UFOs will want\n  you to slow down, and the\n  robots will want to spin.'
  - '* It might be worthwhile to have\n  the human ACT-^05 err... do the\n  things they want by themself.'
  - '* They''ll even change your SOUL\n  to help you do those things!'
  - '* Of course,^05 if you choose to\n  defeat them,^05 then don''t worry\n  about that stuff.'
  adviceSounds:
  - snd_text
  adviceSpeed: 00000000
  advicePortraits: []
