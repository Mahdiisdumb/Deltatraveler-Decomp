--- !u!114 &495
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fbd2c0114102d77c0aab15498ebdd73c, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* Kris,^05 do you think\n  you can eat the\n  orange tiles?'
  - '* Susie,^05 I don''t think\n  that''s how it works.'
  - '* Well he clearly said\n  you''d smell delicious.'
  - I DID IN FACT \nSAY THAT!!!
  - BUT YOU CANNOT \nEAT THE TILES!
  - '* Everything about this\n  keeps getting lamer\n  and lamer.'
  sounds:
  - snd_txtsus
  - snd_txtnoe
  - snd_txtsus
  - snd_txtpap
  - snd_txtpap
  - snd_txtsus
  speed: 00000000
  portraits:
  - su_neutral
  - no_playful
  - su_smile_side
  - ufpap_neutral
  - ufpap_side
  - su_annoyed
  remarks: []
  secondaryLines: 1
  lines2:
  - '* Just do the puzzle,^05\n  Kris.'
  - '* You''re smart,^05 right?'
  - '* You''re like... number\n  three in our class?'
  - '* Whatever the hell\n  Berdly was on about?'
  - '* Whatever.^05\n* Let''s do this.'
  - '* (...?)'
  sounds2:
  - snd_txtsus
  - snd_txtsus
  - snd_txtsus
  - snd_txtsus
  - snd_txtsus
  - snd_txtnoe
  speed2: 00000000
  portraits2:
  - su_annoyed
  - su_smile_side
  - su_neutral
  - su_inquisitive
  - su_neutral
  - no_thinking
  remarks2: []
  vanishAtFlag: -1
  vanishAtCount: 0
  triggerFlag: -1
  forceSecondaryAtFlag: -1
  talkSprites: []
  talkFramerate: 6
--- !u!114 &496
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 11}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fbd2c0114102d77c0aab15498ebdd73c, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* Kris,^05 I think I\n  might remember the\n  rules!'
  - '* So...^05 pink tiles don''t\n  do anything.'
  - '* Red tiles are basically\n  walls.'
  - '* Yellow tiles are walls\n  that hurt you.'
  - '* Orange tiles make you\n  smell like oranges.'
  - '* Purple tiles make you\n  go to the next\n  tile...'
  - '* ... And make you smell\n  like lemons.'
  - '* Blue tiles don''t do\n  anything if you don''t\n  smell like oranges.'
  - '* ... And if they aren''t\n  next to a yellow\n  tile.'
  - '* It''ll act like a\n  yellow tile if it''s\n  next to one.'
  - '* And it''ll otherwise\n  be a wall if you\n  smell like oranges.'
  - '* And white tiles will\n  end the puzzle.'
  - '* That''s what I took\n  away from that,^05 so\n  I hope that helps,^05 Kris.'
  sounds:
  - snd_txtnoe
  - snd_txtnoe
  - snd_txtnoe
  - snd_txtnoe
  - snd_txtnoe
  - snd_txtnoe
  - snd_txtnoe
  - snd_txtnoe
  - snd_txtnoe
  - snd_txtnoe
  - snd_txtnoe
  - snd_txtnoe
  - snd_txtnoe
  speed: 00000000
  portraits:
  - no_confused
  - no_neutral
  - no_neutral
  - no_neutral
  - no_neutral
  - no_neutral
  - no_neutral
  - no_curious
  - no_thinking
  - no_curious
  - no_curious
  - no_neutral
  - no_happy
  remarks: []
  secondaryLines: 0
  lines2:
  - '* [NO_TEXT]'
  sounds2:
  - snd_text
  speed2: 00000000
  portraits2: []
  remarks2: []
  vanishAtFlag: -1
  vanishAtCount: 0
  triggerFlag: 239
  forceSecondaryAtFlag: -1
  talkSprites: []
  talkFramerate: 6
