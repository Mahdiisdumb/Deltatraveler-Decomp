  m_Script: {fileID: 11500000, guid: fbd2c0114102d77c0aab15498ebdd73c, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* Turn every X into -----^05\n* Then press the switch.'
  - '* Love it when the\n  answer is just...^05\n  Gone.'
  - '* Well,^05 why don''t we\n  find out what to\n  do ourselves?'
  - '* Whatever.^05\n* We don''t really have\n  a choice.'
  sounds:
  - snd_text
  - snd_txtsus
  - snd_txtnoe
  - snd_txtsus
  speed: 00000000
  portraits:
  - 
  - su_neutral
  - no_happy
  - su_annoyed
  remarks: []
  secondaryLines: 1
  lines2:
  - '* Y''know...^05\n* Why don''t we just\n  step over the spikes?'
  - '* What if they r-^05raise\n  higher...'
  - '* That sounds kinda\n  badass,^05 not gonna\n  lie.'
  - '* Is it worth it if you\n  aren''t alive to see it?'
  - '* Y''know what,^05 fair point.'
  sounds2:
  - snd_txtsus
  - snd_txtnoe
  - snd_txtsus
  - snd_txtnoe
  - snd_txtsus
  speed2: 00000000
  portraits2:
  - su_smile_sweat
  - no_shocked
  - su_excited
  - no_weird
  - su_smirk_sweat
  remarks2: []
  vanishAtFlag: -1
  vanishAtCount: 0
  triggerFlag: -1
  forceSecondaryAtFlag: 213
  talkSprites: []
  talkFramerate: 6
