  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* Hello there,^05 young travellers!'
  - '* I am not your enemy,^05 but an\n  average mole.'
  - '* I would like to add a bit\n  of flavor to your experience.'
  - '* Or would a bit of advice be\n  more useful to you...?'
  - '* I''m willing to help either way!'
  sounds:
  - snd_text
  speed: 00000000
  portraits: []
  remarks: []
  left: Yes
  leftOffset: {x: 0, y: 0}
  right: No
  rightOffset: {x: 20, y: 0}
  up: Advice
  upOffset: {x: 0, y: 0}
  down:
  downOffset: {x: 0, y: 0}
  centerOffset: {x: 0, y: 0}
