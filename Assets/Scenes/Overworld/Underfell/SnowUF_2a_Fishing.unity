  m_Script: {fileID: 11500000, guid: fbd2c0114102d77c0aab15498ebdd73c, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* (There''s a dirty message\n  written on the attached\n  note.)'
  - '* "For whoever may stumble\n  upon this warning,^05 beware\n  of the woods'' beasts.'
  - '* "They are fierce,^05 wild\n  monsters that only wish\n  to kill.'
  - '* "It was apparently not like\n  this centuries ago,^05 but...'
  - '* "The ground feels more\n  dusty than snowy.'
  - '* "Even worse than all of\n  this is the two-headed\n  creature.'
  - '* "This is the most dangerous\n  of the monsters I have seen\n  down here.'
  - '* "It may not look like it\n  at first,^05 but you can tell\n  based on h"'
  - '* Y''know,^05 I''m not really\n  convinced by this.'
  - '* Kris,^05 your mom warned\n  us about them,^05 but\n  like...'
  - '* They were pretty\n  harmless.'
  - '* But...^05 the ground...'
  - '* Okay, so?'
  - '* Unless some asshole\n  comes charging towards\n  us,^05 we''re fine.'
  - '* ...^05 Okay, Susie.'
  sounds:
  - snd_text
  - snd_text
  - snd_text
  - snd_text
  - snd_text
  - snd_text
  - snd_text
  - snd_text
  - snd_txtsus
