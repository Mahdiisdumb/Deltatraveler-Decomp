  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* No,^05 I didn''t do it.'
  - '* I''m surprised it wasn''t to\n  get that skeleton guy away\n  from the lower part of Snowdin.'
  - '* No...^10 it was the skeleton guy\n  himself that cut the rope\n  to town.'
  - '* Great.'
  sounds:
  - snd_text
  - snd_text
  - snd_text
  - snd_txtsus
  speed: 00000000
  portraits:
  - 
  - 
  - 
  - su_inquisitive
  remarks: []
  secondaryLines: 1
  lines2:
  - '* So what was the\n  rope for, exactly...?'
  - '* It''s to help with climbing\n  this super steep cliff-face.'
  - '* It''s there to avoid people\n  from getting lost in the\n  forest to get to town.'
  - '* I don''t know why they didn''t\n  just add a staircase,^05 or even\n  just make a path to town.'
  - '* But I''m pretty sure it\n  wasn''t even the government that\n  installed the rope.'
  - '* Well this sucks.'
  sounds2:
  - snd_txtnoe
  - snd_text
  - snd_text
  - snd_text
  - snd_text
  - snd_txtsus
  speed2: 00000000
  portraits2:
