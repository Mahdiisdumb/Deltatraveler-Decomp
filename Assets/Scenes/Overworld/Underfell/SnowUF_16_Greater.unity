  m_Script: {fileID: 11500000, guid: fbd2c0114102d77c0aab15498ebdd73c, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* (It''s just a rock.)'
  sounds:
  - snd_text
  speed: 00000000
  portraits: []
  remarks: []
  secondaryLines: 1
  lines2:
  - '* The hell is with the\n  weird looks?'
  - '* It''s literally just\n  a rock.'
  - '* Susie,^05 it''s not just\n  that.'
  - '* What???'
  - '* Wait...'
  - '* ...'
  - '* ...'
  - '* ...'
  - '* ...'
  - '* Okay,^05 fine,^05 it''s just\n  a random statue.^05\n* Now let''s go.'
  sounds2:
  - snd_txtsus
  - snd_txtsus
  - snd_txtnoe
  - snd_txtsus
  - snd_txtsus
  - snd_txtsus
  - snd_txtsus
  - snd_txtsus
  - snd_txtsus
  - snd_txtsus
  speed2: 00000000
  portraits2:
