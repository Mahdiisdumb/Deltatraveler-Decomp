  - su_annoyed
  - no_confused
  - su_inquisitive
  - su_neutral
  - su_side
  - su_neutral
  - su_side
  - su_neutral
  - su_annoyed
  remarks2: []
  vanishAtFlag: -1
  vanishAtCount: 0
  triggerFlag: 276
  forceSecondaryAtFlag: -1
  talkSprites: []
  talkFramerate: 6
--- !u!114 &188
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 24}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fbd2c0114102d77c0aab15498ebdd73c, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* This is ridiculous.'
  - '* The big guy from the guard\n  won''t let me by cuz they''re\n  on high alert.'
  - '* They think there''s a human\n  rummaging around here.'
  - '* O-^05oh,^05 I wonder why\n  they think that?'
  - '* Right???^05\n* I swear these dogs are set\n  off by ANYTHING.'
  - '* Especially ever since the\n  royal scientist got involved.'
  - '* Wait,^05 ALPHYS?????'
  - '* Noel,^05 if you know her,^05 can\n  you tell her to STOP training\n  the dogs to be killers???'
  - '* She ain''t part of the guard,^05\n  and I''m not lookin'' to be\n  oppressed.'
  sounds:
  - snd_text
  - snd_text
  - snd_text
  - snd_txtnoe
  - snd_text
  - snd_text
  - snd_txtnoe
  - snd_text
  - snd_text
  speed: 00000000
  portraits:
  - 
  - 
  - 
  - no_confused_side
  - 
  - 
  - no_shocked
  - 
  - 
  remarks: []
  secondaryLines: 1
  lines2:
  - '* Like a human being spotted even\n  matters these days.'
  - '* With how people act,^05 I''d be\n  surprised if ANYONE let a\n  human live.'
  - '* Whatever.^05\n* Guess I just gotta wait until\n  they call off the search.'
  sounds2:
  - snd_text
  speed2: 00000000
  portraits2: []
  remarks2: []
  vanishAtFlag: -1
  vanishAtCount: 0
  triggerFlag: -1
  forceSecondaryAtFlag: -1
  talkSprites: []
  talkFramerate: 6
