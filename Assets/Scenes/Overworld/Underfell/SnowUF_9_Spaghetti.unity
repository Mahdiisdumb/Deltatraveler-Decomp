  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* (It''s a plate of frozen\n  spaghetti.)'
  - '* Hell yeah!^10\n* Table spaghetti!'
  - '* ...'
  - '* Hey,^05 it''s stuck to\n  the table.'
  sounds:
  - snd_text
  - snd_txtsus
  - snd_txtsus
  - snd_txtsus
  speed: 00000000000000000000000000000000
  portraits:
  - 
  - su_smile
  - su_smile_side
  - su_side_sweat
  remarks: []
  secondaryLines: 1
  lines2:
  - '* WHY WON''T IT COME\n  OFF!??!'
  - '* Susie,^05 I''m pretty sure\n  it''s frozen.'
  - '* Oh...'
  - '* Hey,^05 what if I used\n  RUDE BUSTER?!?!?'
  - '* It m-^05might actually\n  DESTROY the spaghetti...'
  - '* And,^05 umm,^05 the table\n  too...'
  - '* ...^05 FINE,^05 I won''t\n  destroy the table.'
  sounds2:
  - snd_txtsus
  - snd_txtnoe
  - snd_txtsus
  - snd_txtsus
  - snd_txtnoe
  - snd_txtnoe
  - snd_txtsus
