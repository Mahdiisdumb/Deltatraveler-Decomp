MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fbd2c0114102d77c0aab15498ebdd73c, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* (It''s a plate of frozen\n  spaghetti.)'
  - '* Hell yeah!^10\n* Table spaghetti!'
  - '* ...'
  - '* Hey,^05 it''s stuck to\n  the table.'
  sounds:
  - snd_text
  - snd_txtsus
  - snd_txtsus
  - snd_txtsus
  speed: 00000000000000000000000000000000
  portraits:
  - 
  - su_smile
  - su_smile_side
  - su_side_sweat
  remarks: []
  secondaryLines: 1
  lines2:
  - '* WHY WON''T IT COME\n  OFF!??!'
  - '* Susie,^05 I''m pretty sure\n  it''s frozen.'
  - '* Oh...'
  - '* Hey,^05 what if I used\n  RUDE BUSTER?!?!?'
  - '* It m-^05might actually\n  DESTROY the spaghetti...'
  - '* And,^05 umm,^05 the table\n  too...'
  - '* ...^05 FINE,^05 I won''t\n  destroy the table.'
