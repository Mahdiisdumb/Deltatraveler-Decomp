  m_Script: {fileID: 11500000, guid: fbd2c0114102d77c0aab15498ebdd73c, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* Turn every X into an O.^05\n* Then press the switch.'
  - '* Stupid sign.^05\n* We found that out\n  ourselves.'
  - '* Susie,^05 I don''t think\n  it''d know that the one\n  before was destroyed.'
  - '* Sounds like a bad\n  friend if you ask me.'
  sounds:
  - snd_text
  - snd_txtsus
  - snd_txtnoe
  - snd_txtsus
  speed: 00000000
  portraits:
  - 
  - su_confident
  - no_happy
  - su_annoyed
  remarks: []
  secondaryLines: 0
  lines2:
  - '* Okay,^05 so what if instead\n  of fighting whoever\n  these weirdos are...'
  - '* We talk them out of\n  fighting us.'
  - '* They seem like they''d\n  be normal enough to\n  actually TALK to.'
  - '* I can''t really see that\n  happening,^05 but I guess\n  it''s worth a try...?'
  sounds2:
  - snd_txtsus
  - snd_txtsus
  - snd_txtsus
  - snd_txtnoe
  speed2: 00000000
  portraits2:
  - su_smile_sweat
  - su_smile
  - su_smile_sweat
  - no_happy
  remarks2: []
  vanishAtFlag: -1
  vanishAtCount: 0
  triggerFlag: -1
  forceSecondaryAtFlag: -1
  talkSprites: []
  talkFramerate: 6
