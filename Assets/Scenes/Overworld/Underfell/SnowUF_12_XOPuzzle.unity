--- !u!114 &294
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 40b05a73fd437535a0a0e97cd2d2be9d, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - WOULD YOU LIKE A \nHINT?
  - WELL,^05 THAT'S TOO \nBAD FOR YOU!
  - BECAUSE I AM STILL \nUNSURE OF THE \nSOLUTION MYSELF.
  - '* Well hurry it up.'
  - WELL I'M TRYING!!!
  sounds:
  - snd_txtpap
  - snd_txtpap
  - snd_txtpap
  - snd_txtsus
  - snd_txtpap
  speed: 00000000
  portraits:
  - ufpap_neutral
  - ufpap_evil
  - ufpap_side
  - su_annoyed
  - ufpap_mad
  remarks: []
  secondaryLines: 1
  lines2:
  - '* Just ignore him and\n  do the puzzle yourself,^05\n  Kris.'
  - OH NO YOU DON'T!!!
  - '* What are you?^05\n* Berdly?'
  - WHAT THE HELL IS \nA BERDLY?
  - '* You''re acting pretty\n  cocky about this puzzle.'
  - '* Just like someone we\n  know.'
  - WELL,^05 I AM UNSURE \nOF IF THIS PUZZLE \nIS DEADLY OR NOT.
  - AND I WANT TO KILL \nKRIS WITH PURE \nCALCULATED EFFORTS.
  - '* You''re taking this\n  way too seriously.'
  - OH COME ON!!!^05\nIT'S CULTURE!^05\nRESPECT IT!!!
  - '* (The hell is so\n  respectable about\n  killing things???)'
  sounds2:
  - snd_txtsus
  - snd_txtpap
  - snd_txtnoe
  - snd_txtpap
  - snd_txtsus
  - snd_txtsus
  - snd_txtpap
  - snd_txtpap
  - snd_txtsus
  - snd_txtpap
  - snd_txtsus
  speed2: 00000000
  portraits2:
  - su_annoyed
  - ufpap_mad
  - no_playful
  - ufpap_side
  - su_smile
  - su_smile_side
  - ufpap_side
  - ufpap_neutral
  - su_annoyed
  - ufpap_mad
  - su_inquisitive
  remarks2: []
  vanishAtFlag: 234
  vanishAtCount: 1
  triggerFlag: -1
  forceSecondaryAtFlag: -1
  talkSprites: []
  talkFramerate: 6
  stare: 0
  defaultDirection: {x: 1, y: 0}
--- !u!114 &295
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9}
