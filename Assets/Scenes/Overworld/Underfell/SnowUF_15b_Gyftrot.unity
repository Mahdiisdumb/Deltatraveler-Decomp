  m_Script: {fileID: 11500000, guid: 65d4c1103c5d4e42731ff2b51017df77, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* so how''s the traps\n  been going?'
  - '* It''s been real\n  annoying.'
  - '* He''s just been making\n  Kris do all of them.'
  - '* sounds about right.'
  - '* but what about all\n  the effort papyrus has\n  been putting in?'
  - '* HE''S BEEN TRYING\n  TO KILL US.'
  - '* nah,^05 no way.'
  - '* he''d never hurt a fly.'
  - '* or at least he\n  wouldn''t unprovoked.'
  - '* Then why does he\n  force us to do\n  dangerous puzzles?'
  - '* methinks it''s not\n  just him.'
  - '* it''s prolly a good idea\n  to put into perspective\n  what''s going on.'
  - '* Hmm...'
  sounds:
  - snd_txtsans
  - snd_txtsus
  - snd_txtnoe
