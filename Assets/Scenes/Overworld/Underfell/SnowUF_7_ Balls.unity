--- !u!114 &395
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 85}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 12cf6c0ad7b3d747a5e7d5a82df8ac50, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* Hello there,^05 young travellers!'
  - '* I am not your enemy,^05 but an\n  average mole.'
  - '* I would like to add a bit\n  of flavor to your experience.'
  - '* Or would a bit of advice be\n  more useful to you...?'
  - '* I''m willing to help either way!'
  sounds:
  - snd_text
  speed: 00000000
  portraits: []
  remarks: []
  left: Yes
  leftOffset: {x: 0, y: 0}
  right: No
  rightOffset: {x: 20, y: 0}
  up: Advice
  upOffset: {x: 0, y: 0}
  down:
  downOffset: {x: 0, y: 0}
  centerOffset: {x: 0, y: 0}
  talkSprites:
  - {fileID: 21300000, guid: de12456e780860c40a7c071b615fc37b, type: 2}
  - {fileID: 21300000, guid: 91ec87172f1d4e044b71e98359658855, type: 2}
  talkFramerate: 6
  adviceLines:
  - '* It''s a bit jarring to see the\n  enemies in battle appearing <color=#FF0000FF>RED</color>\n  instead of the usual WHITE.'
  - '* That''s because they''re <color=#FF0000FF>HOSTILE</color>!'
  - '* When they''re <color=#FF0000FF>HOSTILE</color>,^05 they\n  won''t even consider mercy\n  until you calm them down.'
  - '* Some will snap out of it when\n  they reach a certain point of\n  health,^05 but some won''t.'
  - '* That means some enemies won''t\n  become sparable at low enough\n  health.'
  - '* So you better be willing to\n  talk if you wanna get by\n  without hurting them.'
  - '* That being said,^05 if a hostile\n  enemy is <color=#00A2E8FF>TIRED</color>,^05 you can still\n  make it fall asleep.'
  - '* If you can find out how\n  to do that,^05 that is.'
  adviceSounds:
  - snd_text
  adviceSpeed: 00000000
  advicePortraits: []
