  m_Script: {fileID: 11500000, guid: fbd2c0114102d77c0aab15498ebdd73c, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* What are you DOING!?'
  - '* This is the third time\n  I''ve caught you snooping\n  around!'
  - '* How the hell did you\n  even get here?'
  - '* H-hey!\n* That''s none of your\n  business, hothead!'
  - '* Umm, yes it is???'
  - '* You keep refusing to\n  show us a way out!'
  - '* You say that as if\n  that old geezer hasn''t\n  tried leaving already.'
  - '* Besides, I don''t need\n  you trying to kill\n  me or the doc.'
  - '* Get outta here before\n  I bash your head in!'
  - '* Or should I burn your\n  roots instead?'
  - '* Fine, fine!!!\n* I''m leaving!!!'
  sounds:
  - snd_txtdes
  - snd_txtdes
  - snd_txtdes
  - snd_txtflw
  - snd_txtdes
  - snd_txtdes
  - snd_txtflw
  - snd_txtdes
  - snd_txtdes
  - snd_txtdes
  - snd_txtflw
  speed: 00000000
