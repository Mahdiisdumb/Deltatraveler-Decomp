  - dess_mad
  - dess_murderous_thought
  - dess_murderous_side
  - flowey_fear
  - dess_mad
  - dess_frustrated
  - flowey_sassy
  - dess_annoyed
  - dess_murderous_thought
  - dess_mischevious
  - flowey_fear
  remarks: []
  secondaryLines: 0
