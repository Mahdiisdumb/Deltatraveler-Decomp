  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* Ribbit,^10 ribbit.\n^10* (Excuse me,^10 human.)'
  - '* (I have some advice\n  for you about battling\n  monsters.)'
  - '* (If you <color=#FFFF00FF>ACT</color> a certain way\n  or <color=#FFFF00FF>FIGHT</color> until you\n  almost defeat them...)'
  - '* (They might not want to\n  battle you anymore.)'
  - '* (If a monster does not\n  want to fight you,^10 please...)'
  - '* (Use some <color=#FFFF00FF>MERCY,</color>^10 human.)^10\n* Ribbit.'
  - '* Why were they only\n  talking to YOU about\n  this,^05 Kris?'
  sounds:
  - snd_text
  - snd_text
  - snd_text
  - snd_text
  - snd_text
  - snd_text
  - snd_txtsus
  speed: 00000000000000000000000000000000000000000000000000000000
  portraits:
  - 
  - 
  - 
  - 
  - 
  - 
  - su_annoyed
  remarks: []
  secondaryLines: 1
  lines2:
  - '* Ribbit,^10 ribbit.\n^10* (Careful,^10 purple lady.)'
  - '* (The human might want to\n  fight <color=#FFFF00FF>you</color>,^05 next.)'
  - '* The next thing that''s\n  boutta get fought is\n  your face.'
  - '* Shiver,^10 shiver.\n^10* (Oh,^10 sorry,^05 I didn''t mean\n  any harm!)'
  sounds2:
  - snd_text
  - snd_text
  - snd_txtsus
  - snd_text
  speed2: 00000000000000000000000000000000
  portraits2:
  - 
  - 
  - su_angry
  - 
  remarks2: []
  vanishAtFlag: -1
  vanishAtCount: -1
  triggerFlag: -1
  forceSecondaryAtFlag: -1
  talkSprites: []
  talkFramerate: 6
