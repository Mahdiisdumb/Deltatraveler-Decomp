--- !u!114 &174
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 22}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fbd2c0114102d77c0aab15498ebdd73c, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* Ah...^05\n* The dawn of a new day...'
  - '* Imperceptible to the night.'
  - '* The only way to tell being\n  clocks and the infrequent\n  holes in the sky.'
  - '* Y''know,^05 if you''re\n  trapped down here...'
  - '* Why not just leave\n  through those holes?'
  - '* Ah,^05 the humans were clever.^05\n* Clever and cruel.'
  - '* The BARRIER isn''t so much\n  a wall,^05 so much as it is\n  a bubble.'
  - '* It seems we''re confined to\n  the limits of the mountain\n  we''re trapped inside.'
  - '* We have tried flying out,^05\n  breaking the rock around us...^05\n* It blocks all the same.'
  - '* A sad reality that you don''t\n  know when you''re younger.'
  sounds:
  - snd_text
  - snd_text
  - snd_text
  - snd_txtsus
  - snd_txtsus
  - snd_text
  - snd_text
  - snd_text
  - snd_text
  - snd_text
  speed: 00000000
  portraits:
  - 
  - 
  - 
  - su_side
  - su_neutral
  - 
  - 
  - 
  - 
  - 
  remarks: []
  secondaryLines: 1
  lines2:
  - '* Seems like hell.'
  - '* One of these days,^05 you will\n  feel my anguish.'
  - '* (Real glad I don''t\n  live here.)'
  sounds2:
  - snd_txtsus
  - snd_text
  - snd_txtsus
  speed2: 00000000
  portraits2:
  - su_smile_sweat
  - 
  - su_side_sweat
  remarks2: []
  vanishAtFlag: -1
  vanishAtCount: 0
  triggerFlag: -1
  forceSecondaryAtFlag: -1
  talkSprites:
  - {fileID: 21300000, guid: 75b374c25d55eb241a59fd79d87f9c31, type: 2}
  - {fileID: 21300000, guid: 97f817249bd2584449f417c21d5af99e, type: 2}
  talkFramerate: 6
