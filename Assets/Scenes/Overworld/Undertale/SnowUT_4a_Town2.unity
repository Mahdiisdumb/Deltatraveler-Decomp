--- !u!114 &171
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 15}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fbd2c0114102d77c0aab15498ebdd73c, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* I''m not like that other mole\n  that''s offering people flavors.'
  - '* I actually work at the CORE.'
  - '* Came by today to make sure\n  Ice Wolf was still throwing\n  Ice to cool the CORE.'
  - '* And...^10 yup!^05\n* He certainly is!^05\n* I sure love PUZZLE!!!'
  sounds:
  - snd_text
  speed: 00000000
  portraits: []
  remarks: []
  secondaryLines: 1
  lines2:
  - '* I''ve gotta say,^05 though.^05\n* There are more moles out today\n  than I thought there were here.'
  sounds2:
  - snd_text
  speed2: 00000000
  portraits2: []
  remarks2: []
  vanishAtFlag: -1
  vanishAtCount: 0
  triggerFlag: -1
  forceSecondaryAtFlag: -1
  talkSprites:
  - {fileID: 21300000, guid: 5e861cc12e2891443a19dbdd03907d64, type: 2}
  - {fileID: 21300000, guid: a7e40b99e13a2f242b85ef07f6cb2d5b, type: 2}
  talkFramerate: 6
