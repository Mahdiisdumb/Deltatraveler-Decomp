  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* (Knock knock knock)'
  - '* Ahh,^05 the sounds of a fresh\n  knock in the morning.'
  - '* It''s music to my ears...'
  sounds:
  - snd_text
  speed: 00000000
  portraits: []
  remarks: []
  secondaryLines: 1
