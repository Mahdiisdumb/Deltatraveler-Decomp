--- !u!114 &182
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 46}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 12cf6c0ad7b3d747a5e7d5a82df8ac50, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* Hello there,^05 young travellers!'
  - '* I am not your enemy,^05 but an\n  average mole.'
  - '* I would like to add a bit\n  of flavor to your experience.'
  - '* Or would a bit of advice be\n  more useful to you...?'
  - '* I''m willing to help either way!'
  sounds:
  - snd_text
  speed: 00000000
  portraits: []
  remarks: []
  left: Yes
  leftOffset: {x: 0, y: 0}
  right: No
  rightOffset: {x: 20, y: 0}
  up: Advice
  upOffset: {x: 0, y: 0}
  down:
  downOffset: {x: 0, y: 0}
  centerOffset: {x: 0, y: 0}
  talkSprites:
  - {fileID: 21300000, guid: 6fdf44db539a1c945ba3325095374a9e, type: 2}
  - {fileID: 21300000, guid: 9fb930ed6ae264948b19b36f4db43f46, type: 2}
  talkFramerate: 6
  adviceLines:
  - '* Say,^05 I hear there''s a strange\n  scientist near the library.'
  - '* He looks eerily similar to\n  one of the residents here.'
  - '* Maybe he has the key to\n  the answers of why you''re\n  here...'
  - '* ...^05 or possibly just the\n  key to someone''s house.'
  adviceSounds:
  - snd_text
  adviceSpeed: 00000000
  advicePortraits: []
