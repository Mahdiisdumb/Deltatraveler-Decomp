  m_Script: {fileID: 11500000, guid: fbd2c0114102d77c0aab15498ebdd73c, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* It''s always so nice visiting\n  Snowdin Town!'
  - '* The people here are so\n  friendly!'
  - '* I just wish it wasn''t so\n  far from home...'
  sounds:
  - snd_text
  speed: 00000000
  portraits: []
  remarks: []
  secondaryLines: 1
  lines2:
  - '* I hear some people are\n  worried about folks from\n  the city coming here.'
  - '* But Snowdin is a lot bigger\n  than people give it\n  credit for!'
  - '* Just take a look at the\n  view by the bridge!'
  - '* Yeah...^10\n* Yeah,^05 that...'
  - '* I wonder what sights\n  we could see if we\n  could go explore.'
  - '* Too bad we...^05 don''t\n  really have time.'
  sounds2:
  - snd_text
  - snd_text
  - snd_text
  - snd_txtsus
  - snd_txtnoe
