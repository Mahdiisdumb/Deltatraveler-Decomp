--- !u!114 &361
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 63}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fbd2c0114102d77c0aab15498ebdd73c, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* Do you think Santa will ever\n  deliver my wish.'
  - '* What would that be?'
  - '* My sister''s return.'
  - '* She had fallen down one day,^05\n  and a doctor healed her\n  to health.'
  - '* But she never came back and\n  the doctor won''t respond to\n  our calls.'
  - '* I''m...^05 so sorry.'
  - '* I''m sure you''ll see\n  her again someday!'
  - '* Really downer way\n  to introduce yourself.'
  - '* It''s why I rarely go out\n  anymore.^05\n* Sigh...'
  sounds:
  - snd_text
  - snd_txtnoe
  - snd_text
  - snd_text
  - snd_text
  - snd_txtnoe
  - snd_txtnoe
  - snd_txtsus
  - snd_text
  speed: 00000000
  portraits:
  - 
  - no_curious
  - 
  - 
  - 
  - no_shocked
  - no_confused_side
  - su_side_sweat
  - 
  remarks: []
  secondaryLines: 1
  lines2:
  - '* I''m at least thankful that\n  my brother is still alive\n  and well.'
  - '* He''s the reason why I\n  still get out of bed.'
  sounds2:
  - snd_text
  speed2: 00000000
  portraits2: []
  remarks2: []
