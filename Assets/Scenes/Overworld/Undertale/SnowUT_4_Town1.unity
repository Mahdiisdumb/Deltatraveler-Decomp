--- !u!114 &334
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fbd2c0114102d77c0aab15498ebdd73c, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* Where the hell am I???'
  - '* I was watching my favorite\n  goat streamer,^05 and then a\n  grey door replaced my closet.'
  - '* When I went inside,^05 I showed\n  up here???'
  - '* Tell me about it,^05\n  dude.'
  sounds:
  - snd_text
  - snd_text
  - snd_text
  - snd_txtsus
  speed: 00000000
  portraits:
  - 
  - 
  - 
  - su_annoyed
  remarks: []
  secondaryLines: 1
  lines2:
  - '* Do you know why\n  it appeared?'
  - '* Umm...'
  - '* The goat got a super rare\n  event on their stream.'
  - '* And then I noticed it.'
  - '* But I can''t say for sure\n  it''s even related.'
  - '* Hmm...'
  sounds2:
  - snd_txtnoe
  - snd_text
  - snd_text
  - snd_text
  - snd_text
  - snd_txtnoe
  speed2: 00000000
  portraits2:
  - no_curious
  - 
  - 
  - 
  - 
  - no_thinking
  remarks2: []
  vanishAtFlag: -1
  vanishAtCount: 0
  triggerFlag: -1
  forceSecondaryAtFlag: -1
  talkSprites:
  - {fileID: 21300000, guid: e0c32e97da02f1a468f865840bd06364, type: 2}
  - {fileID: 21300000, guid: df5ac577857a6ee47aed9d30792bcac9, type: 2}
  talkFramerate: 6
