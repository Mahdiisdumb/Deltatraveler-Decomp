  - 
  - 
  remarks: []
  secondaryLines: 1
  lines2:
  - '* Then again...'
  - '* I''ve been right about weird\n  morning thoughts before.'
  - '* Guess we''ll see.'
  sounds2:
  - snd_text
  speed2: 00000000
