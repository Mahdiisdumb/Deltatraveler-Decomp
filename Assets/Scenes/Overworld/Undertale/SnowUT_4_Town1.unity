  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* What.^10\n* What?^10\n* WHAT!?'
  - '* Can''t a girl break into\n  people''s homes in\n  peace!?'
  - '* God forbid women do\n  ANYTHING.'
  - '* I''ll kick your ass\n  sometime!'
  sounds:
  - snd_text
  speed: 00000000
  portraits:
  - mew_angry
  - mew_mad
  - mew_madside
