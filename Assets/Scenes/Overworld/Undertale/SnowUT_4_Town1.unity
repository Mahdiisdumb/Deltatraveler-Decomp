--- !u!114 &340
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 12}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fbd2c0114102d77c0aab15498ebdd73c, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* Jester?^10\n* No,^05 I''m what some may\n  call a <color=#FF0000FF>demon</color>.'
  - '* Just because I smile all\n  the time doesn''t mean I''m\n  a clown.'
  - '* It even haunts me in my\n  dreams.'
  - '* Being called JEVIL II by\n  someone named...^10\n  <color=#FFFF00FF>something Quetzalcoatl III</color>.'
  - '* I forgot what their first\n  name was...^05\n* Something with a G?'
  - '* I don''t know,^05 but it keeps\n  showing up and punching me\n  in the face.'
  sounds:
  - snd_text
  speed: 00000000
  portraits: []
  remarks: []
  secondaryLines: 1
  lines2:
  - '* How did you remember\n  the stupid ass last\n  name.'
  - '* Because it was so stupid\n  that it''s honestly kinda\n  funny.'
  - '* My friend hates the story,^05\n  but she also hates Sans''s\n  jokes.'
  - '* So I guess it''s on that\n  caliber,^05 haha.'
  sounds2:
  - snd_txtsus
  - snd_text
  - snd_text
  - snd_text
  speed2: 00000000
  portraits2:
  - su_inquisitive
  - 
  - 
  - 
  remarks2: []
  vanishAtFlag: -1
  vanishAtCount: 0
  triggerFlag: -1
  forceSecondaryAtFlag: -1
  talkSprites:
  - {fileID: 21300000, guid: c8bbf01b1f0037a4bab198d215c1ccdf, type: 2}
  - {fileID: 21300000, guid: 9254f78c590dd75439b2299f3fd00ef0, type: 2}
  talkFramerate: 6
--- !u!114 &341
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 14}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fbd2c0114102d77c0aab15498ebdd73c, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* What.^10\n* What?^10\n* WHAT!?'
  - '* Can''t a girl break into\n  people''s homes in peace!?'
  - '* God forbid women do ANYTHING.'
  - '* I''ll kick your ass sometime!'
  sounds:
  - snd_text
  speed: 00000000
  portraits: []
  remarks: []
  secondaryLines: 0
  lines2:
  - '* [NO_TEXT]'
  sounds2:
  - snd_text
  speed2: 00000000
  portraits2: []
  remarks2: []
  vanishAtFlag: -1
  vanishAtCount: 0
  triggerFlag: -1
  forceSecondaryAtFlag: -1
  talkSprites: []
  talkFramerate: 6
--- !u!114 &342
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 15}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fbd2c0114102d77c0aab15498ebdd73c, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* Yo!^05\n* You guys tourists or somethin''?'
  - '* Uhh...^10 I guess?'
  - '* I''m surprised Undyne let ''ya\n  through.'
  - '* She didn''t let me go anywhere\n  near Waterfall earlier!'
  - '* My little sib'' loves Undyne,^05\n  but they aren''t awake yet,^05\n  haha.'
  - '* (Undyne...?)'
  - '* ...^05 Huh?^05\n* The boat?'
  - '* Oh yeah,^05 my bad.'
  - '* I guess you''re fine to\n  stick around.'
  - '* Just don''t follow me!'
  sounds:
  - snd_text
  - snd_txtsus
  - snd_text
  - snd_text
  - snd_text
  - snd_txtnoe
  - snd_text
  - snd_text
  - snd_text
  - snd_text
  speed: 00000000
  portraits:
  - 
  - su_inquisitive
  - 
  - 
  - 
  - no_thinking
  - 
  - 
  - 
  - 
  remarks: []
  secondaryLines: 1
  lines2:
  - '* What?^05\n* You got a secret\n  hide-out or something?'
  - '* W-^05What???^05 No!'
  - '* What do YOU know about me,^05\n  HUH?'
  - '* You''re acting real\n  defensive for someone\n  with nothing to hide.'
  - '* Susie!!!^05\n* Leave her alone!'
  - '* Y-^05yeah,^05 Susie!^05\n* My business ain''t your\n  business!'
  sounds2:
  - snd_txtsus
  - snd_text
  - snd_text
  - snd_txtsus
  - snd_txtnoe
  - snd_text
  speed2: 00000000
  portraits2:
  - su_annoyed
  - 
  - 
  - su_smile
  - no_playful
  - 
  remarks2: []
  vanishAtFlag: -1
  vanishAtCount: 0
  triggerFlag: -1
  forceSecondaryAtFlag: -1
  talkSprites:
