  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* No matter where you\n  go,^05 you can never\n  escape the holidays.'
  - '* Yeah cuz you''re right\n  here.'
  - '* Huh?????^05\n* What does THAT mean???'
  - '* I didn''t mean it in\n  a bad way???'
  - '* I...!'
  - '* ...'
  - '* What.'
