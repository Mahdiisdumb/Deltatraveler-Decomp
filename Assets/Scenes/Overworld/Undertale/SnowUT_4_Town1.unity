  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* Hmm...'
  - '* I get this weird feeling\n  that I''m about to see\n  something disturbing later.'
  - '* Like... someone walking their\n  little brother on a leash.'
  - '* What???'
  - '* Eh,^05 I just woke up.'
  - '* Forget what I said.'
