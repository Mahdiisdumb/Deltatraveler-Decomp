  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* Ribbit,^10 ribbit.\n^10* (I heard using "F4" can make\n  you have a "full screen.")'
  - '* (But what does "F4" stand for?)\n* ("Four frogs"?)'
  - '* (I have only seen a maximum of\n  three frogs in this room...)'
  - '* (This is troubling,^05 to say\n  the least.)\n* Ribbit.'
  sounds:
  - snd_text
  - snd_text
  - snd_text
  - snd_text
  speed: 00000000000000000000000000000000
  portraits:
  - 
  - 
  - 
  - 
  remarks: []
  secondaryLines: 1
  lines2:
  - '* Where are the other\n  two?'
  - '* Ribbit.\n* (They''re scared of you.)'
  - '* Then what about you?'
  - '* Ribbit, ribbit.\n* (Just a gut feeling that you\n  can''t hurt me.)'
  - '* (Go on,^05 try it.)\n* Ribbit.'
  sounds2:
  - snd_txtsus
  - snd_text
  - snd_txtsus
  - snd_text
  - snd_text
  speed2: 0000000000000000000000000000000000000000
  portraits2:
  - su_side
  - 
  - su_inquisitive
  - 
  - 
  remarks2: []
  vanishAtFlag: 32
  vanishAtCount: 3
  triggerFlag: -1
  forceSecondaryAtFlag: -1
  talkSprites: []
  talkFramerate: 6
