  - pap_laugh
  - pap_side
  - pap_neutral
  remarks: []
  secondaryLines: 1
  lines2:
  - YOU DO NOT HAVE \nANYTHING FOR ME \nYET?
  - WELL I AM SURE \nYOU CAN FIND \nSOMETHING!
