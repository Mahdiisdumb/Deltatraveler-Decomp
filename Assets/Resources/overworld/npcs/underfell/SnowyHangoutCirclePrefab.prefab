--- !u!114 &114031129320401204
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1374843717787551}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fbd2c0114102d77c0aab15498ebdd73c, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* Now I know what you''re\n  thinking.'
  - '* "Wasn''t there four red drakes?"'
  - '* No,^05 but NOW I''m\n  worried.'
  - '* Okay,^05 that dude is chilling\n  somewhere else.'
  - '* They needed to reflect on this\n  whole thing,^05 so they aren''t\n  hanging out.'
  - '* I hope they''re okay.'
  sounds:
  - snd_text
  - snd_text
  - snd_txtsus
  - snd_text
  - snd_text
  - snd_text
  speed: 00000000
  portraits:
  - 
  - 
  - su_inquisitive
  - 
  - 
  - 
  remarks: []
  secondaryLines: 1
  lines2:
  - '* So...^05 what about you?'
  - '* Me?^05\n* I''m fine!'
  - '* I found my friend Snowy,^05\n  so it''s all good.'
  - '* ...^05 I''m really hungry though,^05\n  so we should grab a bite\n  somewhere.'
  sounds2:
  - snd_txtsus
  - snd_text
  - snd_text
  - snd_text
  speed2: 00000000
  portraits2:
  - su_neutral
