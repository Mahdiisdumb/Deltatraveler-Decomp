--- !u!114 &114393091042885090
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1237170625056031}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fbd2c0114102d77c0aab15498ebdd73c, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* Wow,^05 what an "ice" party\n  we have here!!!'
  - '* ENOUGH WITH THE\n  PUNS!!!'
  - '* Whatever!!!^05\n* Everyone is here!!!'
  - '* Did you guys do this?'
  - '* Yeah!^05\n* We got everyone to\n  be nicer!'
  - '* And... made the\n  crazy ones less crazy.'
  - '* Thanks a lot,^05 you guys.'
  - '* (This is the one\n  nice thing I''m doing\n  for them.)'
  sounds:
  - snd_text
  - snd_txtsus
  - snd_text
  - snd_text
  - snd_txtnoe
  - snd_txtnoe
  - snd_text
  - snd_txtsus
  speed: 00000000
  portraits:
  - 
  - su_angry
  - 
  - 
  - no_neutral
  - no_weird
  - 
  - su_annoyed
  remarks: []
  secondaryLines: 1
  lines2:
  - '* Consider yourselves honorary\n  members of our squad.'
  - '* Even though you don''t have\n  feathers,^05 and no respect for\n  puns.'
  sounds2:
  - snd_text
  speed2: 00000000
  portraits2: []
  remarks2: []
  vanishAtFlag: -1
  vanishAtCount: 0
  triggerFlag: -1
  forceSecondaryAtFlag: -1
  talkSprites:
  - {fileID: 21300000, guid: 5ecb6672738e17348a819543cee2fe09, type: 2}
  - {fileID: 21300000, guid: 5e8dae8b0965e224681146ae7b2ab059, type: 2}
  talkFramerate: 6
