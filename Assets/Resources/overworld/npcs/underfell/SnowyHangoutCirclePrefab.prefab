  m_Name:
  m_EditorClassIdentifier:
  enabled: 1
  lines:
  - '* Man,^05 I''m so hungry...'
  - '* ...'
  - '* How hungry.'
  - '* Definitely not hungry enough\n  to eat this spaghetti.'
  - '* Bet this was made by that\n  tall skeleton man,^05 which means\n  it sucks!'
  - '* ...'
  - '* More for me.'
  sounds:
  - snd_text
  - snd_txtnoe
  - snd_txtnoe
  - snd_text
  - snd_text
  - snd_txtsus
  - snd_txtsus
  speed: 00000000
  portraits:
  - 
  - no_afraid
  - no_realistic
  - 
  - 
  - su_side
  - su_smile
  remarks: []
  secondaryLines: 1
  lines2:
  - '* Y''know what,^05 fine.'
  - '* I''ll let you have it.'
  - '* ... If you can get it off\n  the table,^05 that is.'
  - '* DAMN IT!!!'
  sounds2:
  - snd_text
  - snd_text
  - snd_text
  - snd_txtsus
