  portraits:
  - 
  - no_afraid
  - no_realistic
  - 
  - 
  - su_side
  - su_smile
  remarks: []
  secondaryLines: 1
  lines2:
  - '* Y''know what,^05 fine.'
  - '* I''ll let you have it.'
  - '* ... If you can get it off\n  the table,^05 that is.'
  - '* DAMN IT!!!'
